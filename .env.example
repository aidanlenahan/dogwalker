# Copy to .env (git-ignored) and fill in. All backend settings use the DOGWALKER_ prefix.

# development | test | production. Production hides /api/docs.
DOGWALKER_ENV=development

# SQLAlchemy URL (psycopg 3 driver). The DB must never be exposed publicly.
DOGWALKER_DATABASE_URL=postgresql+psycopg://dogwalker:change-me@127.0.0.1:5432/dogwalker
# Disposable DB for `pytest`. It is wiped on every run.
DOGWALKER_TEST_DATABASE_URL=postgresql+psycopg://dogwalker:change-me@127.0.0.1:5432/dogwalker_test

# Must be true in production (HTTPS). false for plain-http local dev (Safari won't
# store Secure cookies on http://localhost).
DOGWALKER_COOKIE_SECURE=false
DOGWALKER_SESSION_TTL_DAYS=90

# Optional
# DOGWALKER_FRONTEND_DIST=/path/to/frontend/dist
# DOGWALKER_LOGIN_MAX_FAILURES=10
# DOGWALKER_LOGIN_FAILURE_WINDOW_SECONDS=900

# docker-compose.yml only: password for the postgres container.
POSTGRES_PASSWORD=change-me
